# Dependencies
node_modules

# Build output. `bin/index.js` is generated by `npm run build` and is not
# committed; `main.crdt` IS committed because the SDK generates it from the
# composite and the Creator Hub expects it present.
bin/

# Secrets. Never commit a wallet key.
.env

# Temporary bundle produced by `npm run check`
.check-logic.cjs

# Editor / OS
.DS_Store
**/.DS_Store
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# NOTE: package-lock.json is intentionally NOT ignored. CI uses `npm ci`, which
# requires it, and it pins the exact @dcl/sdk@auth-server build so the server
# half of the game resolves reproducibly.
